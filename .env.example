# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS: comma-separated list of frontend / Spring Boot origins ---
ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Storage (relative paths are resolved against the ai-service folder) ---
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=enterprise_docs
UPLOAD_DIR=./uploads
KEEP_UPLOADS=true

# --- Embeddings ---
# Model name OR a local directory path (use a local path for air-gapped deployments).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PRELOAD_MODEL=true

# --- Chunking (characters) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Limits ---
MAX_UPLOAD_MB=25
DEFAULT_TOP_K=5
MAX_TOP_K=20
